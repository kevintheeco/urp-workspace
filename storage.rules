rules_version = '2';
// ⚠️ Firebase Storage 규칙 (yourprofessor-94a2d.firebasestorage.app)
// 워크스페이스 포털의 파일 저장소: Surf In 문서 사진(ws-docs/*), 사내 드라이브(ws-files/*).
// 2026-06-23 초기 세팅 때 잠금 모드(전부 거부)로 게시된 채 방치 → 업로드 전멸 (2026-07-07 발견·교체).
// 2026-07-14 정식 게시: firebase.json에 storage 항목이 빠져 그동안 한번도 배포된 적 없던 것이 진짜 원인.
//   → firebase.json에 storage 추가 후 `firebase deploy --only storage`로 서비스계정 게시(요나단). 라이브 확인 완료.
// 원칙: Firestore ws_members 명단에 있는 팀 멤버만 읽기/쓰기 (Firestore 규칙의 isMember()와 동일 기준).
service firebase.storage {
  match /b/{bucket}/o {
    function isMember() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/ws_members/$(request.auth.token.email));
    }
    // 초대장 서약서 보관함 (2026-08-24 요나단). 초대장 서명 시 서약 확인서 JPG가 여기 올라온다.
    // 쓰기만 열고(3MB 이하 JPG/PDF) 수정·삭제는 막아 서명 기록의 위변조를 방지. 읽기는 업로드 토큰 URL로만.
    match /pledges/{fileName} {
      allow create: if request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|application/pdf');
      allow read, update, delete: if false;
    }
    // URP 재무 보드 영수증/증빙 — Firestore fin_rooms와 동일한 "경로 비밀" 모델(로그인 없음).
    // roomId가 비밀번호의 SHA-256 해시(64자 hex)인 걸 아는 사람만 읽고/올릴 수 있음.
    match /fin_rooms/{room}/receipts/{allPaths=**} {
      allow read: if room.matches('^[a-f0-9]{64}$');
      allow write: if room.matches('^[a-f0-9]{64}$') && request.resource.size < 10 * 1024 * 1024;
    }
    match /{allPaths=**} {
      allow read, delete: if isMember();
      // 업로드는 50MB 상한 (무료 요금제 총 5GB 보호)
      allow create, update: if isMember() && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
