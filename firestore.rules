rules_version = '2';
// ⚠️⚠️ 공유 규칙 — 니가교수 앱 + 대학생 앱(univ.provee.kr) + 회사 워크스페이스 포털 + 재무보드가
//        같은 Firebase 프로젝트(yourprofessor-94a2d)를 함께 씀.
// ⚠️ Firestore 규칙은 프로젝트당 "딱 1세트"뿐. 게시할 땐 반드시 아래 통합본 "전체"를 게시할 것!
//    - users 규칙만 게시 → 워크스페이스 포털 깨짐
//    - ws_* 규칙만 게시 → 앱 클라우드 동기화 깨짐 ("클라우드 연결 실패")  ← 2026-07-01 실제 발생
//    - study_cards 빠짐 → 학습 허브 죽음  ← 2026-08-31 실제 발생
//    - codes·beta_slots·app_config 빠짐 → 대학생 앱 로그인 후 진입 불가  ← 2026-09-02 실제 발생
// ⚠️ 게시 전에 반드시: 아래 컬렉션 블록이 전부 있는지 확인 —
//    users / codes / app_config / beta_slots / beta_apply / usage_events /
//    meus_rooms / aca_shared / study_cards / fin_rooms / ws_*
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function slotDoc(slot) {
      return get(/databases/$(database)/documents/beta_slots/$(string(slot)));
    }

    // ⚠️ 익명 로그인(#beta 신청용)은 아무나 즉시 얻는다 — "로그인했다"만으로 열어주는 규칙에서는 배제한다.
    function realUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/ws_members/$(request.auth.token.email));
    }

    // 워크스페이스: 팀 제출 결과 — 멤버만 읽기, 본인만 쓰기
    // 2026-09-02: 읽기가 signedIn()이라 로그인한 누구나 볼 수 있었다. OAuth 앱을 프로덕션으로 게시하면서
    //             아무 구글 계정이나 로그인할 수 있게 되어 isMember()로 조임. 현재 어느 앱도 이 컬렉션을 쓰지 않는다.
    match /ws_team/{uid} {
      allow write: if signedIn() && request.auth.uid == uid;
      allow read:  if isMember();
    }

    // 워크스페이스: 멤버 명단
    // 2026-09-02: 읽기가 signedIn()이라 팀 이메일 목록이 외부에 노출됐다.
    //             단 본인 문서는 계속 읽혀야 로그인 게이트가 "명단에 없음"을 판별할 수 있으므로 본인 것만 예외로 둔다.
    match /ws_members/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isMember());
      allow write: if isMember() || request.auth.token.email == 'soomin020114@gmail.com';
    }

    // 대표 일정은 전 직원이 보되, 일정 자체는 대표만 편집한다.
    match /ws_ceo_schedule/{id} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.token.email == 'soomin020114@gmail.com';
    }

    // 미팅 신청은 본인이 만들고 볼 수 있으며, 대표는 전체 신청을 검토한다.
    match /ws_ceo_meeting_requests/{id} {
      allow create: if isMember()
        && request.resource.data.requesterEmail == request.auth.token.email;
      allow read: if isMember() && (
        resource.data.requesterEmail == request.auth.token.email
        || request.auth.token.email == 'soomin020114@gmail.com'
      );
      allow update, delete: if isMember()
        && request.auth.token.email == 'soomin020114@gmail.com';
    }

    // 니가교수 앱: 본인 데이터 (하위 컬렉션 data/ 까지 포함) — {document=**} 빠지면 동기화 거부됨
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 니가교수·대학생 앱: 이메일→학원코드 명부 (ADR-014). 본인 이메일 문서 + 관리자는 전체 읽기(대시보드 코드→이름 변환용).
    // 관리자 외 write 규칙 없음 = 클라이언트 수정 불가(자기 등록 create/이름 backfill update만 예외).
    // ⚠️ 2026-09-02: 이 블록이 규칙 재배포 때 빠져 univ.provee.kr 로그인 후 진입 불가가 됐었음. 지우지 말 것!
    match /codes/{email} {
      allow read: if signedIn() && (request.auth.token.email == email
        || request.auth.token.email in ['soomin020114@gmail.com', 'tangbole0430@gmail.com',
          'junseo.lim@urpedu.com']);
      // 자기 등록. 내가 선점한 자리(beta_slots)의 코드만, 1회만 쓸 수 있다. 신청 페이지(#beta)로 온
      // 사람과 구글 로그인만 한 사람 둘 다 자리를 하나씩 잡으므로 이 규칙 하나로 덮인다.
      // update가 없으므로 남의 코드로 바꿔치기·기존 등록자 덮어쓰기는 불가.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['code', 'slot', 'name', 'adult'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && (!('adult' in request.resource.data) || request.resource.data.adult is bool)
        && request.resource.data.slot is int
        && slotDoc(request.resource.data.slot).data.uid == request.auth.uid
        && slotDoc(request.resource.data.slot).data.email == email
        && slotDoc(request.resource.data.slot).data.code == request.resource.data.code;
      // 이름 뒤늦게 채우기 — 빈칸일 때만·name 한 필드만·본인 문서만.
      allow update: if signedIn() && request.auth.token.email == email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && (!('name' in resource.data) || resource.data.name == '')
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40;
    }

    // 공개 가입 스위치(app_config/open_beta). 문서 존재 여부만 본다 — 지우면 앱이 자리를 자동 배정하지 않는다.
    // 쓰기 규칙 없음 = 콘솔·Admin에서만 켜고 끈다.
    match /app_config/{doc} {
      allow read: if realUser();
    }

    // 베타 신청 자리 — 미리 발급한 학원코드를 한 자리씩 심어둔다(beta_slots/{1..N} = {code}).
    // 학원코드는 워커에서 사실상 출입증이라 남은 코드 목록이 노출되면 크레딧을 그대로 도둑맞는다.
    //  · read: 내 uid로 잠근 자리만 → 선점 전에는 코드를 볼 수 없다.
    //  · update: uid가 비어 있을 때만 → 먼저 쓴 사람이 임자(배타적 잠금). code 변경·재선점 불가.
    match /beta_slots/{slot} {
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && !resource.data.keys().hasAny(['uid'])
        && request.resource.data.keys().hasOnly(['code', 'email', 'uid', 'ts'])
        && request.resource.data.code == resource.data.code
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 60
        && request.resource.data.ts is number;
    }

    // 베타 신청서(이름·연락처 — 개인정보). 본인 이메일 문서만 1회 생성, 수정·삭제 불가.
    match /beta_apply/{email} {
      allow get: if signedIn() && (request.auth.token.email == email
        || request.auth.token.email in ['soomin020114@gmail.com', 'tangbole0430@gmail.com']);
      allow list: if signedIn() && request.auth.token.email in ['soomin020114@gmail.com', 'tangbole0430@gmail.com'];
      allow create: if signedIn()
        && slotDoc(request.resource.data.slot).data.uid == request.auth.uid
        && slotDoc(request.resource.data.slot).data.email == email
        && request.resource.data.keys().hasOnly(['name', 'phone', 'school', 'adult', 'guardian', 'slot', 'ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.school is string && request.resource.data.school.size() <= 20
        && request.resource.data.adult is bool
        && request.resource.data.guardian is bool
        && request.resource.data.slot is int
        && request.resource.data.ts is number;
    }

    // AI 사용량 이벤트(문제당 원가 측정). 본인 uid로만 생성, 수정·삭제 불가(영수증 위조 방지).
    // 읽기는 관리자만 — 비용 대시보드용.
    match /usage_events/{id} {
      allow create: if realUser() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && request.auth.token.email in ['soomin020114@gmail.com', 'tangbole0430@gmail.com',
        'junseo021024@gmail.com', 'junseo.lim@urpedu.com'];
    }

    // MEUS 무로그인 그룹방(수련회 등): meus_rooms/{방}/members/{이름} = {name, code, ts}
    // 링크 소지자 누구나 읽기/제출(로그인 불필요). 필드·크기 엄격 제한, 삭제는 운영자 계정만.
    match /meus_rooms/{room}/members/{member} {
      allow read: if true;
      allow create, update: if
        request.resource.data.keys().hasOnly(['name', 'code', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 2
        && request.resource.data.code.size() <= 4000
        && request.resource.data.ts is number
        && member.size() <= 60;
      allow delete: if signedIn() && (
        request.auth.token.email == 'soomin020114@gmail.com'
        || get(/databases/$(database)/documents/meus_rooms/$(room)).data.owner == request.auth.uid
      );
    }

    // MEUS 그룹방 이름표(meta/info {title, mode?}) — 누구나 읽기, 쓰기·삭제는 운영자 계정 또는 방장(owner) 본인
    // mode = 업무/친구 모드(2026-07-18 추가) — 없으면 업무로 취급(레거시 방 호환)
    // 2026-07-21: 누구나 방장(owner)이 될 수 있는 "내 방" 기능 추가 — owner uid 매칭 시에도 허용
    match /meus_rooms/{room}/meta/{doc} {
      allow read: if true;
      allow create, update: if signedIn()
        && (
          request.auth.token.email == 'soomin020114@gmail.com'
          || get(/databases/$(database)/documents/meus_rooms/$(room)).data.owner == request.auth.uid
        )
        && request.resource.data.keys().hasOnly(['title', 'mode'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 60
        && (!('mode' in request.resource.data) || request.resource.data.mode in ['work', 'friend']);
      allow delete: if signedIn() && (
        request.auth.token.email == 'soomin020114@gmail.com'
        || get(/databases/$(database)/documents/meus_rooms/$(room)).data.owner == request.auth.uid
      );
    }

    // MEUS 그룹방 등록부(부모 문서 {title, mode?, ts, owner?}) — 운영자 대시보드 + 누구나 방장 "내 방" 대시보드 겸용
    // owner 필드 없는 방=대표님 계정(운영자)이 예전 방식으로 만든 레거시 방. owner 있으면 그 uid가 방장.
    match /meus_rooms/{room} {
      allow read: if signedIn() && (
        resource.data.owner == request.auth.uid
        || request.auth.token.email == 'soomin020114@gmail.com'
      );
      allow create: if signedIn() && (
        (request.resource.data.owner == request.auth.uid)
        || (request.auth.token.email == 'soomin020114@gmail.com' && !('owner' in request.resource.data))
      ) && request.resource.data.keys().hasOnly(['title', 'mode', 'ts', 'owner'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 60
        && (!('mode' in request.resource.data) || request.resource.data.mode in ['work', 'friend'])
        && request.resource.data.ts is number;
      allow update: if signedIn() && (
        resource.data.owner == request.auth.uid
        || request.auth.token.email == 'soomin020114@gmail.com'
      )
        // owner가 이미 있으면 못 바꾼다(탈취 방지). 아직 없던 방(레거시)에 처음 매기는 건 허용.
        && (
          !('owner' in resource.data)
          || !('owner' in request.resource.data)
          || request.resource.data.owner == resource.data.owner
        );
      allow delete: if signedIn() && (
        resource.data.owner == request.auth.uid
        || request.auth.token.email == 'soomin020114@gmail.com'
      );
    }

    // MEUS 운영자: 모든 방의 제출을 한 번에 조회 (collectionGroup 'members') — 운영자 계정만.
    // 현재 'members' 서브컬렉션은 meus_rooms에서만 사용.
    match /{path=**}/members/{member} {
      allow read: if signedIn() && request.auth.token.email == 'soomin020114@gmail.com';
    }

    // 니가교수 학원 연동: 학생이 옵트인으로 공유한 학습 신호 (aca_shared/{code}__{uid})
    // 쓰기: 본인(uid가 문서 id 끝과 일치 + 데이터의 uid 필드도 본인)만.
    // 읽기: 본인 것만. (+ 대표 계정은 점검용)
    // ⚠️ 2026-09-02 변경: 예전에는 read가 signedIn()이라 로그인한 아무나 전체 학생의 공유 데이터를 읽을 수 있었다.
    //    OAuth 앱을 프로덕션으로 게시하면서 아무 구글 계정이나 로그인 가능해졌고, 학원 연동을 쓰는 곳이 아직 없어(대표 확인)
    //    본인+대표로 잠갔다. 학원 관리자에게 열어줄 때는 aca_admins/{code}__{email} 명단을 만들어 exists()로 확인할 것.
    //    그 전까지 학원 대시보드는 동작하지 않는다.
    match /aca_shared/{docId} {
      allow write: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && docId == request.resource.data.code + '__' + request.auth.uid;
      allow delete: if signedIn() && docId.matches('.*__' + request.auth.uid);
      allow read: if signedIn() && (
        docId.matches('.*__' + request.auth.uid)
        || request.auth.token.email == 'soomin020114@gmail.com'
      );
    }

    // 학습 허브(study-hub): 카드 읽기는 링크 소지자 누구나(팀 공유 대시보드, 로그인 없음 — meus_rooms와 같은 모델).
    // 쓰기는 상태 버튼(status/statusAt)만 바꾸게 제한. 카드 생성·삭제는 Admin SDK(study-push.js)만 하므로 차단.
    // ⚠️ 2026-08-31: 이 블록이 규칙 재배포 때 빠져서 허브가 "Missing or insufficient permissions"로 죽은 적 있음. 지우지 말 것!
    match /study_cards/{id} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusAt'])
        && request.resource.data.status in ['todo', 'learned', 'adopted', 'dropped']
        && request.resource.data.statusAt is number;
      allow create, delete: if false;
    }

    // URP 재무 보드 (fin_rooms)
    // 보안이 2중이다: ① 비밀번호 SHA-256 해시(64자 hex)가 방 경로 ② 워크스페이스 팀원 계정
    // ⚠️ 2026-09-02 변경: 예전에는 경로 비밀만으로 열렸다. 비밀번호가 짧고 팀에 알려져 있어
    //    퇴사자나 링크 소지자가 회사 재무를 볼 수 있었다. 구글 로그인 + ws_members 명단을 추가 조건으로 건다.
    // ⚠️ 절대 fin_rooms/{room} 최상위 문서를 만들지 말 것(방 목록 열람 차단 유지). 데이터는 전부 한 단계 아래 컬렉션에.
    // 단일 세그먼트 와일드카드만 사용 — {document=**}를 쓰면 fin_rooms 목록 조회가 열릴 수 있음.
    // 준서는 구글 계정이 두 개다(개인 gmail + 회사 워크스페이스 메일). 회사메일로 로그인했다가
    // 재무보드가 "연결에 실패했어요"로 튕긴 일이 있어(2026-09-02) 두 계정 모두 넣는다.
    function finBoss() {
      return signedIn() && request.auth.token.email in [
        'soomin020114@gmail.com',     // 김수민 대표
        'junseo021024@gmail.com',     // 임준서 CFO (개인)
        'junseo.lim@urpedu.com'       // 임준서 CFO (회사메일)
      ];
    }
    // 자본·지분(캡테이블·자금유입)은 대표와 CFO만. 다른 팀원도 볼 수 없다.
    match /fin_rooms/{room}/captable/{doc} {
      allow read, write: if room.matches('^[a-f0-9]{64}$') && finBoss();
    }
    match /fin_rooms/{room}/funding/{doc} {
      allow read, write: if room.matches('^[a-f0-9]{64}$') && finBoss();
    }
    // 재무 데이터 전체(지출·시나리오·손익 포함)도 대표·CFO만.
    // 2026-09-02 대표 지시: "나랑 준서만 일단 보게 하자". 팀원 열람 허용을 철회한다.
    // ⚠️ 규칙은 겹치면 "하나라도 통과하면 열림"이다. 좁은 규칙이 넓은 규칙을 덮어쓰지 않는다.
    //    한때 여기에 isMember() 조건을 뒀다가 팀원이 캡테이블을 읽을 수 있었다(손정범 계정으로 확인).
    match /fin_rooms/{room}/{coll}/{doc} {
      allow read, write: if room.matches('^[a-f0-9]{64}$') && finBoss();
    }

    // 워크스페이스 컬렉션(ws_*) — 멤버만 읽기/쓰기
    match /{coll}/{id} {
      allow read, write: if isMember()
        && coll.matches('ws_.*')
        && coll != 'ws_ceo_schedule'
        && coll != 'ws_ceo_meeting_requests';
    }
  }
}
